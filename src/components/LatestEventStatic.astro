---
import { formatItalianDateTime, toRomeCalendarDay } from '@/components/DateUtils'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'

// Everything here runs at build time. The page stays up to date without commits because
// .github/workflows/netlify-rebuild.yml triggers a Netlify rebuild several times a day.

// How many events to show under "Coming soon", after the main "Next event" card.
const MAX_COMING_SOON_EVENTS = 3

// "status=Live" returns only published events that are not over yet, and "order=start_date"
// puts the closest one first.
const UPCOMING_EVENTS_URL =
    'https://gdg.community.dev/api/event_slim/for_chapter/854/' +
    '?status=Live&order=start_date&include_cohosted_events=true&visible_on_parent_chapter_only=true' +
    '&fields=title,start_date,end_date,event_type_title,cropped_picture_url,url' +
    `&page_size=${1 + MAX_COMING_SOON_EVENTS}&page=1`

type GdgEvent = {
    title: string
    start_date: string
    end_date: string
    event_type_title?: string
    cropped_picture_url: string
    url: string
}

const response = await fetch(UPCOMING_EVENTS_URL)
const data: { results: GdgEvent[] } = await response.json()

// Safety net in case the API still reports as "Live" an event that has already ended.
const now = new Date()
const upcomingEvents = data.results.filter(event => new Date(event.end_date) > now)

// The closest event gets the big card, the following ones a compact link each.
// When the closest one ends, the next rebuild promotes the following one automatically.
const [nextEvent, ...comingSoonEvents] = upcomingEvents

// How long after the end of the last event its feedback link stays on the page.
// The link disappears at the first scheduled rebuild after this window.
const FEEDBACK_VISIBLE_DAYS = 7

// Most recent completed event, used to pre-fill the feedback form with its title.
const LAST_COMPLETED_EVENT_URL =
    'https://gdg.community.dev/api/event_slim/for_chapter/854/' +
    '?status=Completed&order=-start_date&include_cohosted_events=true&visible_on_parent_chapter_only=true' +
    '&fields=title,end_date&page_size=1&page=1'

const lastCompletedResponse = await fetch(LAST_COMPLETED_EVENT_URL)
const lastCompletedData: { results: Pick<GdgEvent, 'title' | 'end_date'>[] } = await lastCompletedResponse.json()
const lastCompletedEvent = lastCompletedData.results.find(event => {
    const feedbackDeadline = new Date(event.end_date)
    feedbackDeadline.setDate(feedbackDeadline.getDate() + FEEDBACK_VISIBLE_DAYS)
    return feedbackDeadline > now
})

// Google Form shared by all events: "entry.1235423955" is the event-name question,
// pre-filled so attendees do not have to type it.
const FEEDBACK_FORM_URL =
    'https://docs.google.com/forms/d/e/1FAIpQLSdPCraC4NxEaxKEcqUIE7llG3xbBZtHiQnlKPh3hVzHe1be7Q/viewform'

// On the day of an event the feedback link already points to it, so organisers can show it
// during the event. The API keeps an event "Live" until it ends, so it is still in upcomingEvents.
const todayInRome = toRomeCalendarDay(now)
const todaysEvent = upcomingEvents.find(event => toRomeCalendarDay(new Date(event.start_date)) <= todayInRome)

const feedbackEvent = todaysEvent ?? lastCompletedEvent
const feedbackUrl =
    feedbackEvent && `${FEEDBACK_FORM_URL}?usp=pp_url&entry.1235423955=${encodeURIComponent(feedbackEvent.title)}`
---

{
    (nextEvent || feedbackUrl) && (
        <section class="panel panel--blue">
            {nextEvent && (
                <>
                    <h2 class="panel__title">Next event</h2>
                    <a class="event-card" href={nextEvent.url} target="_blank" rel="noopener noreferrer">
                        {/*
                            The picture is downloaded and resized at build time and served from our own
                            domain in a few sizes, so phones do not download the full 1000px original.
                            The API always serves a square picture (1000x1000).
                        */}
                        {/* The frame crops the black border baked into the picture: see style.css. */}
                        <div class="event-card__picture-frame">
                            <Image
                                class="event-card__picture"
                                src={nextEvent.cropped_picture_url}
                                alt=""
                                width={1000}
                                height={1000}
                                widths={[400, 600, 800, 1000]}
                                sizes="(max-width: 600px) calc(100vw - 70px), 546px"
                                loading="eager"
                                fetchpriority="high"
                            />
                        </div>
                        <div class="event-card__body">
                            {nextEvent.event_type_title && (
                                <span class="event-card__eyebrow">{nextEvent.event_type_title}</span>
                            )}
                            <h3 class="event-card__title">{nextEvent.title}</h3>
                            <p class="event-card__date">{formatItalianDateTime(nextEvent.start_date)}</p>
                        </div>
                    </a>

                    {comingSoonEvents.length > 0 && (
                        <>
                            <h2 class="panel__title panel__title--secondary">Coming soon</h2>
                            {comingSoonEvents.map(event => (
                                <a class="link-pill" href={event.url} target="_blank" rel="noopener noreferrer">
                                    <span class="link-pill__icon">
                                        <Icon name="material-symbols:calendar-today" />
                                    </span>
                                    <span class="link-pill__label">
                                        {event.title}
                                        <span class="link-pill__detail">{formatItalianDateTime(event.start_date)}</span>
                                    </span>
                                </a>
                            ))}
                        </>
                    )}
                </>
            )}

            {feedbackUrl && (
                <>
                    {/* Secondary heading only when it follows the "Next event" card. */}
                    <h2 class={nextEvent ? 'panel__title panel__title--secondary' : 'panel__title'}>
                        {todaysEvent ? "Today's event" : 'Last event'}
                    </h2>
                    <a class="link-pill" href={feedbackUrl} target="_blank" rel="noopener noreferrer">
                        <span class="link-pill__icon">
                            <Icon name="material-symbols:feedback-rounded" />
                        </span>
                        <span class="link-pill__label">
                            {todaysEvent ? "Feedback from today's event" : 'Feedback from last event'}
                            <span class="link-pill__detail">{feedbackEvent.title}</span>
                        </span>
                    </a>
                </>
            )}
        </section>
    )
}
