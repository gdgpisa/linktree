---
import { isDateTimeInRange } from '@/components/DateUtils'
import LatestEventStatic from '@/components/LatestEventStatic.astro'
import data from '@/data.yaml'
import '@/style.css'
import { Icon } from 'astro-icon/components'

// Tint applied to each link section, cycling in this order (see `.panel--*` in style.css).
// The "latest event" panel rendered above the sections is always blue, so sections start from red.
const PANEL_COLORS = ['red', 'yellow', 'green', 'blue']

const GITHUB_REPO_URL = 'https://github.com/gdgpisa/linktree'

const visibleSections = data.sections
    .map(section => ({
        title: section.title,
        links: section.links.filter(link => link.visible && isDateTimeInRange(link.dataInizio, link.dataFine)),
    }))
    .filter(section => section.links.length > 0)
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>GDG Pisa &bull; Links</title>
        <meta name="description" content="GDG Pisa: tutti i link utili della community, eventi, social e DevFest." />
        <meta property="og:title" content="GDG Pisa • Links" />
        <meta property="og:description" content="GDG Pisa: Tech Community" />
        <meta property="og:url" content="https://links.gdgpisa.it" />
        <meta property="og:image" content="/gdg-pisa-logo.svg" />
        <link rel="icon" href="/gdg-pisa-logo.svg" />
        <link
            rel="preload"
            href="/fonts/product-sans/ProductSans-Regular.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
        <link rel="preload" href="/fonts/product-sans/ProductSans-Bold.woff2" as="font" type="font/woff2" crossorigin />
        <script is:inline>
            // Runs before first paint to avoid a flash of the wrong theme.
            // Same storage key as gdgpisa.it, but localStorage is per-domain so the choice is not shared.
            try {
                const stored = localStorage.getItem('gdgpisa-theme')
                if (stored === 'light' || stored === 'dark') {
                    document.documentElement.setAttribute('data-theme', stored)
                }
            } catch {}

            // Hero colour: one of the four Google colours, picked at random on every visit.
            // Set here (before first paint) so the hero never flashes the default blue. See style.css.
            const heroColors = ['blue', 'red', 'yellow', 'green']
            document.documentElement.setAttribute(
                'data-hero',
                heroColors[Math.floor(Math.random() * heroColors.length)],
            )
        </script>
    </head>
    <body>
        <header class="hero">
            <button type="button" id="theme-toggle" class="theme-toggle" aria-label="Toggle light/dark theme">
                <span class="theme-toggle__icon theme-toggle__icon--sun">
                    <Icon name="material-symbols:light-mode-outline" />
                </span>
                <span class="theme-toggle__icon theme-toggle__icon--moon">
                    <Icon name="material-symbols:dark-mode-outline" />
                </span>
            </button>

            <a
                class="github-corner"
                href={GITHUB_REPO_URL}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Fork me on GitHub"
            >
                <svg viewBox="0 0 250 250" aria-hidden="true">
                    <path class="github-corner__bg" d="M0,0 L115,115 L130,115 L142,142 L250,250 L250,0 Z"></path>
                    <path
                        class="github-corner__octo github-corner__arm"
                        d="M128.3,109.0 C113.8,99.7 119.0,89.6 119.0,89.6 C122.0,82.7 120.5,78.6 120.5,78.6 C119.2,72.0 123.4,76.3 123.4,76.3 C127.3,80.9 125.5,87.3 125.5,87.3 C122.9,97.6 130.6,101.9 134.4,103.2"
                    ></path>
                    <path
                        class="github-corner__octo"
                        d="M115.0,115.0 C114.9,115.1 118.7,116.5 119.8,115.4 L133.7,101.6 C136.9,99.2 139.9,98.4 142.2,98.6 C133.8,88.0 127.5,74.4 143.8,58.0 C148.5,53.4 154.0,51.2 159.7,51.0 C160.3,49.4 163.2,43.6 171.4,40.1 C171.4,40.1 176.1,42.5 178.8,56.2 C183.1,58.6 187.2,61.8 190.9,65.4 C194.5,69.0 197.7,73.2 200.1,77.6 C213.8,80.2 216.3,84.9 216.3,84.9 C212.7,93.1 206.9,96.0 205.4,96.6 C205.1,102.4 203.0,107.8 198.3,112.5 C181.9,128.9 168.3,122.5 157.7,114.1 C157.9,116.9 156.7,120.9 152.7,124.9 L141.0,136.5 C139.8,137.7 141.6,141.9 141.8,141.8 Z"
                    ></path>
                </svg>
            </a>

            <div class="hero__content">
                <img class="hero__logo" src="/gdg-pisa-logo.svg" alt="GDG Pisa logo" width="327" height="226" />
                <p class="hero__overline">Google Developer Group</p>
                <h1>GDG Pisa</h1>
                <p class="hero__tagline">Tech Community</p>
                <nav class="social" aria-label="Social">
                    {
                        data.social
                            .filter(item => item.visible)
                            .map(({ title, icon, url }) => (
                                <a
                                    class="social__item"
                                    href={url}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    title={title}
                                    aria-label={title}
                                >
                                    <Icon name={icon} />
                                </a>
                            ))
                    }
                </nav>
            </div>
        </header>

        <main class="container">
            <LatestEventStatic />

            {
                visibleSections.map((section, index) => (
                    <section class={`panel panel--${PANEL_COLORS[index % PANEL_COLORS.length]}`}>
                        {section.title && <h2 class="panel__title">{section.title}</h2>}
                        {section.links.map(({ title, icon, url }) => (
                            <a class="link-pill" href={url} target="_blank" rel="noopener noreferrer">
                                <span class="link-pill__icon">
                                    <Icon name={icon} />
                                </span>
                                <span class="link-pill__label">{title}</span>
                            </a>
                        ))}
                    </section>
                ))
            }
        </main>

        <script>
            // Theme toggle: flips between light and dark and remembers the choice.
            // With no stored choice the page follows the OS preference (see style.css).
            const root = document.documentElement
            const toggle = document.getElementById('theme-toggle')

            const currentTheme = () => {
                const forced = root.getAttribute('data-theme')
                if (forced === 'light' || forced === 'dark') {
                    return forced
                }
                return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
            }

            toggle?.addEventListener('click', () => {
                const next = currentTheme() === 'dark' ? 'light' : 'dark'
                root.setAttribute('data-theme', next)
                try {
                    localStorage.setItem('gdgpisa-theme', next)
                } catch {}
            })
        </script>
    </body>
</html>
